---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CareerSnapshot from '../components/CareerSnapshot.astro';
import ProjectPipeline from '../components/ProjectPipeline.astro';
import EvidencePreview from '../components/EvidencePreview.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="TAERIM KIM · QA Portfolio" description="반복되는 품질 문제를 구조로 바꾸는 QA Engineer, TAERIM KIM의 Portfolio PoC">
  <Header home={true} />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">QA PORTFOLIO · PROOF OF CONCEPT</p>
          <h1 id="hero-title">반복되는 품질 문제를<br />구조로 바꾸는 QA</h1>
          <p class="hero-support">테스트를 수행하는 데서 끝나지 않고, 반복되는 문제와 비용을 줄이는 방법을 찾습니다.<br class="desktop-break" /> QA가 본질이고, 기술은 품질 문제 해결을 위한 수단으로 사용합니다.</p>
          <p class="hero-meta">Game · HW/SW · E-Commerce · Fintech/Auth</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">프로젝트 보기</a>
            <a class="button secondary" href="#evidence">QA Evidence 보기</a>
          </div>
        </div>
        <aside class="hero-index" aria-label="Portfolio reading order">
          <span>READING ORDER</span>
          <ol>
            <li><b>01</b> Problem</li>
            <li><b>02</b> Context & Role</li>
            <li><b>03</b> Approach</li>
            <li><b>04</b> QA / Validation</li>
            <li><b>05</b> Evidence</li>
          </ol>
        </aside>
      </div>
    </section>
    <CareerSnapshot />
    <ProjectPipeline />
    <EvidencePreview />
  </main>
  <Footer />
</BaseLayout>
