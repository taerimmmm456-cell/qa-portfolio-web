---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CareerSnapshot from '../components/CareerSnapshot.astro';
import ProjectPipeline from '../components/ProjectPipeline.astro';
import EvidencePreview from '../components/EvidencePreview.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="TAERIM KIM · QA Portfolio" description="기획 검토, 테스트 실행, 영향 범위 판단과 재검증 사례를 담은 김태림의 QA 포트폴리오">
  <Header home={true} />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">QA ENGINEER · TAERIM KIM</p>
          <h1 id="hero-title">테스트 기준을 세우고<br />영향 범위를 확인합니다</h1>
          <p class="hero-support">기획 문서의 충돌을 QA 전에 확인하고, BAT에서 테스트 불가 상태를 걸러냈습니다.<br class="desktop-break" /> 공유 기능의 수정은 기존 기능까지 재검증합니다.</p>
          <p class="hero-meta">Game · HW/SW · E-Commerce · Fintech/Auth</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">프로젝트 보기</a>
            <a class="button secondary" href="#evidence">QA Evidence 보기</a>
          </div>
        </div>
        <aside class="hero-index" aria-label="Portfolio reading order">
          <span>PORTFOLIO GUIDE</span>
          <ol>
            <li><b>01</b> QA 경험</li>
            <li><b>02</b> 업무 개선</li>
            <li><b>03</b> 판단 사례</li>
            <li><b>04</b> 검증 자료</li>
          </ol>
        </aside>
      </div>
    </section>
    <CareerSnapshot />
    <ProjectPipeline />
    <EvidencePreview />
  </main>
  <Footer />
</BaseLayout>
