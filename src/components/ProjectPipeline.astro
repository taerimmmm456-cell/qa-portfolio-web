---
import { projects } from '../content/portfolio';
import ProjectCard from './ProjectCard.astro';

const connectors = [
  { label: '다음 과제', text: 'TC 초안과 QA 지식 탐색' },
  { label: '현재 검토', text: '민감정보를 다루는 내부 환경' },
];
---

<section class="section pipeline" id="projects" aria-labelledby="projects-title">
  <div class="shell">
    <div class="section-heading pipeline-heading">
      <div>
        <p class="eyebrow">QA PROJECTS</p>
        <h2 id="projects-title">QA 업무에서 만든 <span class="headline-phrase">도구와 검증</span></h2>
      </div>
      <p>반복 검증은 자동화하고, TC·QA 지식 탐색은 Assistant로 다뤘습니다. 내부 환경 적용은 검증 중입니다.</p>
    </div>
    <div class="pipeline-grid">
      {projects.map((project, index) => (
        <>
          <ProjectCard project={project} />
          {index < connectors.length && (
            <div class="connector" aria-label={`${connectors[index].label}: ${connectors[index].text}`}>
              <span>{connectors[index].label}</span>
              <strong>{connectors[index].text}</strong>
              <i aria-hidden="true"></i>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
