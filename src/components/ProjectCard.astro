---
import type { Project } from '../content/portfolio';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-topline">
    <span class="project-number">PROJECT {project.number}</span>
    <span class:list={['status', { progress: project.status === 'In Progress' }]}>{project.status === 'Completed' ? '완료' : '진행 중'}</span>
  </div>
  <h3>{project.name}</h3>
  <dl class="project-details">
    <div>
      <dt>문제</dt>
      <dd>{project.problem}</dd>
    </div>
    <div>
      <dt>{project.status === 'In Progress' ? '현재 검토' : '대응'}</dt>
      <dd>{project.change}</dd>
    </div>
    {project.judgment && (
      <div class="project-judgment">
        <dt>QA 판단</dt>
        <dd>{project.judgment}</dd>
      </div>
    )}
    {project.result && (
      <div class="project-result">
        <dt>확인된 결과</dt>
        <dd>{project.result}</dd>
      </div>
    )}
    <div>
      <dt>담당 범위</dt>
      <dd class="role-list">{project.roles.join(' · ')}</dd>
    </div>
  </dl>
  <div class="project-footer">
    <a class="text-link" href={project.href}>{project.cta}</a>
    {project.sourceHref && <a class="text-link source-entry-link" href={project.sourceHref}>원본 자료 보기 →</a>}
  </div>
</article>
