---
import { qaCoverage, qaDomains } from '../content/portfolio';

const careerTimeline = [
  { company: '헥토큐앤엠', period: '2026.06–현재', role: 'QA 선임', domain: 'Fintech / Auth Platform', expansion: 'PASS Auth QA · Automation Tool · AI QA Assistant' },
  { company: '비단팝팝', period: '2025.12–2026.04', role: 'QA 대리', domain: 'E-Commerce', expansion: '신규 QA 프로세스 · E-Commerce · MSSQL 데이터·비즈니스 로직 검증' },
  { company: '파우게임즈', period: '2024.01–2025.04', role: 'QA 사원', domain: 'Game', expansion: '라이브 QA · QA 문서·협업 프로세스 개선' },
  { company: '큐로드', period: '2022.05–2023.09', role: 'QA 사원', domain: 'Game / HW·SW Integration', expansion: '다프로젝트 QA · HW/SW Integration · 교육·인계' },
  { company: '아이피시', period: '2021.04–2022.05', role: 'QA 사원', domain: 'Game', expansion: '런칭·라이브 QA · 탐색적 테스트 · Sub Leader' },
];
---

<section class="section career" id="career" aria-labelledby="career-title">
  <div class="shell">
    <div class="section-heading">
      <p class="eyebrow">QA EXPERIENCE</p>
      <h2 id="career-title">다뤄 온 QA 영역</h2>
    </div>
    <div class="career-grid">
      <article class="career-panel">
        <h3>QA Domains</h3>
        <ul class="domain-list" role="list">
          {qaDomains.map((domain) => <li>{domain}</li>)}
        </ul>
      </article>
      <article class="career-panel coverage-panel">
        <h3>QA Coverage</h3>
        <ol class="coverage-flow">
          {qaCoverage.map((item) => <li>{item}</li>)}
        </ol>
      </article>
    </div>
    <div class="career-timeline" aria-labelledby="career-timeline-title">
      <h3 id="career-timeline-title">Career Timeline</h3>
      <ol>
        {careerTimeline.map((item) => (
          <li>
            <strong>{item.company}</strong>
            <span>{item.period} · {item.role}</span>
            <span>{item.domain}</span>
            <span class="career-expansion"><b>주요 경험</b>{item.expansion}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="career-judgment">
      <span>요구사항 검토 사례</span>
      <p>기획 리뷰에서 삭제·변경된 기능과 문서의 잔존 내용이 충돌하는 것을 발견하고, QA 시작 전에 정합성 확보를 요청했습니다.</p>
      <a href="/evidence/qa-process-career/">QA 판단 사례 보기 →</a>
    </div>
  </div>
</section>
